# ─── Banco de Dados ───────────────────────────────────────────────────────────
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change_me_postgres

MONGO_USER=report
MONGO_PASSWORD=change_me_mongo
MONGO_DB=reports

# ─── Object Storage (MinIO) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=diagrams

# ─── Message Broker (RabbitMQ) ────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me_rabbitmq

# ─── AWS (DynamoDB Local) ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=fakekey
AWS_SECRET_ACCESS_KEY=fakesecret

# ─── Segurança ────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
# Credenciais do endpoint POST /auth/login
AUTH_USERNAME=admin
# Gere o hash com: htpasswd -bnBC 10 "" sua_senha | tr -d ':\n'
# ou: go run -mod=mod golang.org/x/crypto/bcrypt@latest
# Os $ do hash bcrypt devem ser escapados como $$ para o Docker Compose não tratá-los como variáveis
AUTH_PASSWORD_HASH=$$2y$$10$$ZTduRtZKMwcAKcl4cv51X.KKgNrlS7c4vS42asZuEnL6sgIP8bI3y

# ─── Observabilidade (New Relic) ──────────────────────────────────────────────
NEW_RELIC_LICENSE_KEY=your_newrelic_license_key_here
NEW_RELIC_APP_NAME=fiap-secure-systems

# ─── IA ───────────────────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=your_api_key_here
LLM_MODEL=claude-sonnet-4-6
