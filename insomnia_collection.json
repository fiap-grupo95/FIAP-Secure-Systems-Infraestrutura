{
  "info": {
    "_postman_id": "fiap-secure-systems-mvp",
    "name": "FIAP Secure Systems — MVP",
    "description": "Analisador de diagramas de arquitetura via IA.\nFluxo: login → upload → processamento IA → relatório de segurança.\n\nOrdem de uso:\n1. Execute '0. Login' → copie o token para a variável jwt_token\n2. Upload Diagrama → copie process_id\n3. Poll Status até ANALISADO → copie report_id\n4. Get Report",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Checks",
      "description": "Verifica se todos os serviços HTTP estão no ar",
      "item": [
        {
          "name": "Gateway /ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/ping",
              "host": ["{{gateway_url}}"],
              "path": ["ping"]
            },
            "description": "Verifica o api-gateway (porta 8080)"
          },
          "response": []
        },
        {
          "name": "Orchestrator /ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orchestrator_url}}/ping",
              "host": ["{{orchestrator_url}}"],
              "path": ["ping"]
            },
            "description": "Verifica o upload-orchestrator (porta 8081)"
          },
          "response": []
        },
        {
          "name": "Report Service /ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{report_url}}/ping",
              "host": ["{{report_url}}"],
              "path": ["ping"]
            },
            "description": "Verifica o report-service (porta 8083)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Fluxo End-to-End (API Publica)",
      "description": "Execute nesta ordem:\n1. Login → copie o token para jwt_token\n2. Upload Diagrama → copie process_id\n3. Poll Status até ANALISADO → copie report_id\n4. Get Report",
      "item": [
        {
          "name": "0. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 200 && json.token) {",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
                  "    console.log('jwt_token atualizado — expira em ' + json.expires_in + 's');",
                  "} else {",
                  "    console.error('Login falhou: ' + pm.response.code + ' ' + JSON.stringify(json));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica e retorna JWT (expira em 1h).\nO script de teste preenche jwt_token automaticamente após o login com sucesso."
          },
          "response": []
        },
        {
          "name": "1. Upload Diagrama",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 202 && json.process_id) {",
                  "    pm.collectionVariables.set('process_id', json.process_id);",
                  "    console.log('process_id atualizado: ' + json.process_id);",
                  "} else {",
                  "    console.error('Upload falhou: ' + pm.response.code + ' ' + JSON.stringify(json));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "insomnia-upload-001",
                "description": "ID de rastreamento propagado a todos os servicos"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "diagram",
                  "type": "file",
                  "src": "",
                  "description": "Imagem do diagrama (PNG, JPEG, WebP ou PDF — max 10MB)"
                }
              ]
            },
            "url": {
              "raw": "{{gateway_url}}/api/diagrams",
              "host": ["{{gateway_url}}"],
              "path": ["api", "diagrams"]
            },
            "description": "Envia diagrama de arquitetura para analise. Requer JWT. Copie o process_id da resposta."
          },
          "response": []
        },
        {
          "name": "2a. Poll Status — RECEBIDO",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "insomnia-status-001"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/process/{{process_id}}/status",
              "host": ["{{gateway_url}}"],
              "path": ["api", "process", "{{process_id}}", "status"]
            },
            "description": "Execute logo apos o upload. Status esperado: RECEBIDO."
          },
          "response": []
        },
        {
          "name": "2b. Poll Status — EM_PROCESSAMENTO",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "insomnia-status-002"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/process/{{process_id}}/status",
              "host": ["{{gateway_url}}"],
              "path": ["api", "process", "{{process_id}}", "status"]
            },
            "description": "Execute apos alguns segundos. Status esperado: EM_PROCESSAMENTO."
          },
          "response": []
        },
        {
          "name": "2c. Poll Status — ANALISADO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (pm.response.code === 200 && json.status === 'ANALISADO' && json.report_id) {",
                  "    pm.collectionVariables.set('report_id', json.report_id);",
                  "    console.log('report_id atualizado: ' + json.report_id);",
                  "} else if (pm.response.code === 200) {",
                  "    console.warn('Status atual: ' + json.status + ' — aguarde e repita a requisição');",
                  "} else {",
                  "    console.error('Erro ao consultar status: ' + pm.response.code + ' ' + JSON.stringify(json));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "insomnia-status-003"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/process/{{process_id}}/status",
              "host": ["{{gateway_url}}"],
              "path": ["api", "process", "{{process_id}}", "status"]
            },
            "description": "Execute ate obter status ANALISADO. A resposta incluira report_id — copie para a variavel."
          },
          "response": []
        },
        {
          "name": "3. Get Report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "insomnia-report-001"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/reports/{{report_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "reports", "{{report_id}}"]
            },
            "description": "Busca o relatorio tecnico. Disponivel apenas quando status = ANALISADO."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Casos de Erro",
